<Project>
  <!-- Shared package refs -->
  <ItemGroup>
    <!--
      NBGV drives versions. PrivateAssets has to sit on the PackageReference: NuGet
      reads only Version from a PackageVersion item, so the PrivateAssets that used to
      live in Directory.Packages.props never applied, and 3.4.2 shipped
      Nerdbank.GitVersioning as a dependency of both packages.
    -->
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />

    <!-- SourceLink for GitHub -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- SourceLink / build hygiene -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Package metadata applied only to packable projects -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageIcon>assets/icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Stillpoint-Software/Hyperbee.Templating/releases/latest</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Stillpoint-Software/Hyperbee.Templating</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Stillpoint-Software/Hyperbee.Templating</PackageProjectUrl>
  </PropertyGroup>

  <!-- Pull README & LICENSE into the package root -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="..\..\assets\icon.png" Pack="true" Visible="false" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Link="README.md" />

    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath="\"
          Link="LICENSE" />
  </ItemGroup>
  <!-- Global project properties - .NET 10 LTS First Strategy -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Primary target: .NET 10 (LTS), with .NET 11 (STS) for current support.
      net8.0 and net9.0 are gone: both reached end of support on 2026-11-10.
      netstandard2.1 is the compatibility floor, so a net8.0 or net9.0 consumer
      resolves that asset and keeps working.
    -->
    <!--
      The condition keeps this off BenchmarkDotNet's generated project. BDN writes a
      project into the benchmark project's bin directory, inside this tree, so this
      file is imported into it. Its own <TargetFramework> is the singular form and
      loses to the plural form here, so it cross-targets and then demands a
      netstandard2.1 asset from the benchmark project it references, failing with
      NU1201 before a single benchmark runs. BDN does set ImportDirectoryBuildProps
      to false, but that sits in the project body, which MSBuild evaluates only
      after Microsoft.Common.props has already imported this file.
    -->
    <TargetFrameworks Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">net11.0;net10.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <!--
    The SDK defaults netstandard2.1 to C# 8, which predates records, init accessors
    and collection expressions, so the sources fail to parse there. net10.0 and
    net11.0 already default to the SDK's latest, so this only affects netstandard.
  -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    PolySharp generates the two compiler-required types netstandard2.1 lacks,
    IsExternalInit and CallerArgumentExpressionAttribute, as internal types in each
    assembly that references it. On net10.0 and net11.0, where the framework has
    them, it emits [TypeForwardedTo] instead. That forwarder is what keeps init
    accessors binding when code compiled against the netstandard2.1 asset runs on a
    net10.0+ asset; without it the call throws MissingMethodException.

    Only these two types are generated. Everything else PolySharp can polyfill is
    left off so no unused internal types land in the assemblies.
  -->
  <PropertyGroup>
    <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.IsExternalInit;System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</PolySharpIncludeGeneratedTypes>
  </PropertyGroup>
</Project>

