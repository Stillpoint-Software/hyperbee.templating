<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Pinned, not inherited: Directory.Build.props adds netstandard2.1 for the
      shipped libraries, and there is no test host for netstandard2.1.
    -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="TestSupport\Resources\TextFile1.txt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestSupport\Resources\TextFile1.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hyperbee.Collections" />
    <PackageReference Include="Hyperbee.Resources" />
    <PackageReference Include="Hyperbee.XS" />
    <PackageReference Include="Hyperbee.XS.Extensions" />    
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperbee.Templating.Provider.XS\Hyperbee.Templating.Provider.XS.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Templating\Hyperbee.Templating.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Opt-in: run this suite against the netstandard2.1 build of the libraries
    instead of the matching net10.0/net11.0 build. netstandard2.1 is not a
    runtime and cannot host a test, so the tests still execute on net10.0 or
    net11.0; only the libraries under test change. This is what exercises the
    #if NETSTANDARD branches, including the Assembly.Load path that stands in
    for the collectible load context, and the compiler types PolySharp
    generates for netstandard2.1.

      dotnet test <project> -f net10.0 -p:UseNetstandardAsset=true
  -->
  <ItemGroup Condition="'$(UseNetstandardAsset)' == 'true'">
    <ProjectReference Update="..\..\src\Hyperbee.Templating\Hyperbee.Templating.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.1" />
    <ProjectReference Update="..\..\src\Hyperbee.Templating.Provider.XS\Hyperbee.Templating.Provider.XS.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>
</Project>